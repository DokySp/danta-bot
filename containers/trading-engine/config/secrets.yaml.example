# Copy to secrets.yaml in this directory; chmod 600 secrets.yaml.
# Quote all values. Empty strings remain unresolved; this file grants no authority.
# Account number (8 digits) + "-" + product code (2 digits).
KIS_ACCOUNT_REF: ""
KIS_APP_KEY: ""
KIS_APP_SECRET: ""
# Issued access tokens are managed in state_dir/kis-token.json, never here.
DART_API_KEY: ""
TELEGRAM_GATEWAY_URL: ""
# Only needed for approved Telegram ingress with a verified signing gateway.
DANTA_TELEGRAM_PEER_SECRET: ""
# Dedicated Codex authentication/state directory, separate from broker credentials.
# compose.auth.yaml login and compose.runtime.yaml share this directory.
DANTA_CODEX_AUTH_HOME: "/app/auth"
