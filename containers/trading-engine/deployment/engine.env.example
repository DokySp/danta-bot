# Paths are relative to this computer's trading-engine directory; no developer-PC paths.
DANTA_IMAGE=dokysp/trading-engine:SET_RELEASE_TAG
DANTA_CONFIG_DIR=./config
DANTA_STATE_DIR=./var
DANTA_LOCK_DIR=./locks
DANTA_APPROVAL_DIR=./approvals
DANTA_AUTH_VOLUME=trading-engine-auth
DANTA_GATEWAY_NETWORK=danta-catalyst-net
