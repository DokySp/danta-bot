# Paths are relative to this computer's codex-exec directory; no developer-PC paths.
DANTA_IMAGE=dokysp/codex-exec:SET_RELEASE_TAG
DANTA_CONFIG_DIR=./config
DANTA_STATE_DIR=./var
DANTA_LOCK_DIR=./locks
DANTA_APPROVAL_DIR=./approvals
DANTA_AUTH_VOLUME=codex-exec-auth
DANTA_GATEWAY_NETWORK=danta-catalyst-net
